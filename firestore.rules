rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Collaborator')
        : 'Collaborator';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'juanrael@gmail.com' ||
        userRole() == 'Admin'
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        userRole() == 'Teacher'
      );
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      // Owners can update their own data except `role` and `teams` (admin-only).
      // Admins can update everything.
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'teams']))
        || isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // --- Projects ---
    function isValidProject(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('team' in data) || (data.team is string && data.team.size() <= 100))
        && (!('sprintStates' in data) || data.sprintStates is list);
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidProject(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('createdAt', null) != null;
      allow update: if (isOwner(resource.data.createdBy) || isAdmin())
        && isValidProject(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('updatedAt', null) != null;
      allow delete: if isOwner(resource.data.createdBy) || isAdmin();
    }

    // --- Sprints ---
    function isValidSprint(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.projectId is string && data.projectId.size() > 0
        && (!('stateId' in data) || (data.stateId is string && data.stateId.size() > 0 && data.stateId.size() <= 128))
        && (!('team' in data) || (data.team is string && data.team.size() <= 100));
    }

    function sprintIsClosed(sprintId) {
      return exists(/databases/$(database)/documents/sprints/$(sprintId))
        && get(/databases/$(database)/documents/sprints/$(sprintId)).data.get('isClosed', false) == true;
    }

    match /sprints/{sprintId} {
      allow read: if isSignedIn();
      allow create: if isTeacher()
        && isValidSprint(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('createdAt', null) != null
        && request.resource.data.get('isClosed', false) == false;
      // Reopening a closed sprint (isClosed transitioning from true to false) is admin-only.
      // Closing or any other update can be done by teachers.
      allow update: if request.resource.data.get('updatedAt', null) != null
        && (
          isAdmin() ||
          (isTeacher() && resource.data.get('isClosed', false) == false)
        )
        && (
          // Standard update with full validation; createdBy must not change
          (isValidSprint(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy) ||
          // Migration: Adding projectId to existing sprint without projectId
          (resource.data.projectId == null && request.resource.data.projectId is string &&
           request.resource.data.name == resource.data.name &&
           request.resource.data.createdBy == resource.data.createdBy)
        );
      allow delete: if isTeacher();
    }

    // --- Tasks ---
    function isValidTask(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.sprintId is string
        && data.weight is number && data.weight >= 0
        && data.status is string && data.status.size() > 0
        && (data.status != 'in_progress' || data.get('assignedTo', null) != null)
        && (data.status != 'done' || data.get('finishedBy', null) != null)
        && data.createdBy == (resource == null ? request.auth.uid : resource.data.createdBy);
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      // Block task writes on closed sprints — closed sprints are frozen records.
      allow create: if isSignedIn()
        && isValidTask(request.resource.data)
        && request.resource.data.get('createdAt', null) != null
        && !sprintIsClosed(request.resource.data.sprintId);
      allow update: if isSignedIn() && isValidTask(request.resource.data) && request.resource.data.get('updatedAt', null) != null && !sprintIsClosed(resource.data.sprintId) && (
        // Action: Assign Task
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTo', 'status', 'updatedAt']) && request.resource.data.status == 'in_progress' && (request.resource.data.assignedTo == request.auth.uid || isTeacher())) ||
        // Action: Finalize Task
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finishedBy', 'status', 'updatedAt']) && request.resource.data.status == 'done') ||
        // Action: Move Task
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Action: Edit Task Details (any subset of editable fields, including comments)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'weight', 'description', 'color', 'links', 'emailAlerts', 'comments', 'updatedAt']) && (isTeacher() || resource.data.createdBy == request.auth.uid)) ||
        // Action: Add/Remove Comments only (any signed-in user — kept for non-creator collaborators)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updatedAt']))
      );
      allow delete: if (isTeacher() || resource.data.createdBy == request.auth.uid)
        && !sprintIsClosed(resource.data.sprintId);
    }

    // --- Notifications ---
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn(); // System creates notifications
      allow update: if isOwner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // --- Mail queue (consumed by Firebase "Trigger Email" extension) ---
    // Documents are deleted by the extension after delivery; only writes are needed.
    match /mail/{mailId} {
      allow create: if isSignedIn()
        && request.resource.data.to is string
        && request.resource.data.message.subject is string;
      allow read, update, delete: if false;
    }
  }
}
